	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Muon</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.3.5</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.harshvaid.Muon</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>muon</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>LSMinimumSystemVersion</key>
	<string>26.0</string>
	<key>LSUIElement</key>
	<true/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSAppleEventsUsageDescription</key>
	<string>Muon asks apps to quit and runs menu commands you request.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Muon listens only while the mic is on, to type your request. Speech is recognized on-device.</string>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Muon transcribes audio files you choose, on-device.</string>
